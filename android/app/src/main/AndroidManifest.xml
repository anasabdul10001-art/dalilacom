<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".DalilacomApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dalilacom"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dalilacom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Back from the Facebook login browser when connecting a Page to the auto-responder
                 (section 7/23). singleTask keeps the running app instead of stacking a second copy,
                 so the intent arrives in onNewIntent and the responder screen can react to it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dalilacom" android:host="responder" android:pathPrefix="/meta" />
            </intent-filter>

            <!-- Back from a Google / Facebook sign-in: the server's callback page sends the browser here with a
                 one-time ticket (dalilacom://auth/social?ticket=...) or the reason it failed (?social_error=...). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dalilacom" android:host="auth" android:pathPrefix="/social" />
            </intent-filter>

            <!-- Tapping a push notification opens the in-app inbox. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dalilacom" android:host="app" android:pathPrefix="/notifications" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.DalilacomMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- What a push shows when it is drawn by the system (app closed): the logo as the small icon, brand red accent, same channel as the server sends to. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_dalilacom" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/brand_red" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="dalilacom_default" />
    </application>
</manifest>
