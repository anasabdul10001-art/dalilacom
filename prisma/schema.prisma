generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  CONFIRMED
  CANCELLED
}

enum MerchantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CommissionType {
  PERCENT
  FIXED
}

enum AffiliateSourceType {
  ORDER
  DISCOUNT_TRANSACTION
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  fullName        String
  role            Role      @default(CUSTOMER)
  tokenVersion    Int       @default(0) // bumped on logout / password reset to invalidate existing JWTs (section 56)
  isEmailVerified Boolean   @default(false)
  isDisabled      Boolean   @default(false) // admin-controlled kill switch, blocks login regardless of tokenVersion
  bio             String? // short public description shown on the account's profile / shop page
  avatarUpdatedAt DateTime? // set when a profile photo exists; also the cache-busting version in its URL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     Membership[]
  merchantProfile MerchantProfile?
  avatar          UserAvatar?
  cart            Cart?
  orders          Order[]
  affiliateOf     MerchantAffiliate[] // merchants I market for
  referredAs      AffiliateReferral[] // merchants that credit a specific affiliate for my purchases

  wallet                Wallet?
  walletTransactions    WalletTransaction[]
  topUpRequests         TopUpRequest[]
  responderSubscription ResponderSubscription?
  channelConnections    ChannelConnection[]
  responderRules        ResponderRule[]
  responderInteractions ResponderInteraction[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  securityEvents          SecurityEvent[]

  addresses         Address[]
  businessMembers   BusinessMember[]
  favoriteMerchants FavoriteMerchant[]
}

// Only a SHA-256 hash of the raw token is ever stored — the raw value exists only in the
// email link and is never persisted (section: Email Verification).
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Single-use, expiring, hash-only storage — same pattern as EmailVerificationToken
// (section: Password Reset).
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum SecurityEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  TOKEN_REVOKED
  RATE_LIMIT_EXCEEDED
}

// Append-only audit trail of security-relevant events (section: Security Events). Never
// stores passwords, raw tokens, or secrets — only what's needed to investigate later.
model SecurityEvent {
  id        String            @id @default(uuid())
  userId    String?
  type      SecurityEventType
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// One pricing plan a customer can subscribe to (Admin-managed, section 24/60/61)
model MembershipPlan {
  id           String   @id @default(uuid())
  name         String
  durationDays Int
  priceCents   Int
  currency     String   @default("EUR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
}

// A customer's active/expired subscription instance — this IS the digital card (section 19)
model Membership {
  id                   String           @id @default(uuid())
  memberNumber         String           @unique // human-facing membership number
  userId               String
  planId               String
  status               MembershipStatus @default(ACTIVE)
  startDate            DateTime         @default(now())
  endDate              DateTime
  qrSecret             String // per-membership secret used to derive rotating QR tokens (section 62)
  lastRedeemedTimeStep BigInt? // replay-protection watermark for QR redemption
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user User           @relation(fields: [userId], references: [id])
  plan MembershipPlan @relation(fields: [planId], references: [id])

  discountTransactions DiscountTransaction[]

  @@index([userId])
}

// Admin-managed, hierarchical (section 10): a category can have a parent category
model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  icon      String? // emoji shown on browse tiles
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  translations CategoryTranslation[]
  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryHierarchy")
  merchants    MerchantProfile[]
  products     Product[]

  businesses     Business[]
  productMasters ProductMaster[]
}

// A merchant's business profile (section 3)
model MerchantProfile {
  id              String                 @id @default(uuid())
  userId          String                 @unique
  businessName    String
  categoryId      String
  address         String?
  latitude        Float?
  longitude       Float?
  phone           String?
  whatsapp        String?
  approvalStatus  MerchantApprovalStatus @default(PENDING) // manual admin approval (section 63)
  rejectionReason String?
  // {"sat":[{"open":"09:00","close":"22:00"}], ...} — validated in routes; evaluated in the platform timezone
  openingHours    Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user                 User                  @relation(fields: [userId], references: [id])
  category             Category              @relation(fields: [categoryId], references: [id])
  favoritedBy          FavoriteMerchant[]
  discounts            Discount[]
  discountTransactions DiscountTransaction[]
  products             Product[]
  orders               Order[]
  affiliates           MerchantAffiliate[]

  @@index([categoryId])
}

// A product in a merchant's e-commerce store (section 5/26)
model Product {
  id                    String   @id @default(uuid())
  merchantId            String
  categoryId            String?
  name                  String
  description           String?
  priceCents            Int
  memberDiscountEnabled Boolean  @default(false)
  memberPriceCents      Int? // set by the merchant when memberDiscountEnabled (section 5 example: €100 -> €85)
  stock                 Int      @default(0)
  sku                   String?
  isActive              Boolean  @default(true) // merchant-controlled visibility, independent of stock (section 59.1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  merchant           MerchantProfile     @relation(fields: [merchantId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  cartItems          CartItem[]
  orderItems         OrderItem[]
  affiliateReferrals AffiliateReferral[]

  @@index([merchantId])
}

// One active cart per customer (section 6)
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

// One order per merchant — a multi-merchant cart splits into one of these per merchant at
// checkout (section 59.5's "Sub-Orders"), each with its own status/tracking.
model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique
  userId              String
  merchantId          String
  status              OrderStatus @default(PENDING)
  subtotalCents       Int
  memberDiscountCents Int         @default(0)
  totalCents          Int
  cancelReason        String? // required when the merchant cancels (section 59.6)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  merchant MerchantProfile @relation(fields: [merchantId], references: [id])
  items    OrderItem[]

  @@index([userId])
  @@index([merchantId])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String
  productName    String // snapshot at order time, survives later product edits
  quantity       Int
  unitPriceCents Int // price actually charged per unit (member price when applied)
  createdAt      DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// A discount rule offered by a merchant (section 4)
model Discount {
  id         String    @id @default(uuid())
  merchantId String
  title      String
  percent    Int
  isActive   Boolean   @default(true)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  merchant             MerchantProfile       @relation(fields: [merchantId], references: [id])
  discountTransactions DiscountTransaction[]

  @@index([merchantId])
}

// Single source of truth discount redemption log (section 34)
model DiscountTransaction {
  id                  String            @id @default(uuid())
  transactionRef      String            @unique @default(uuid())
  membershipId        String
  merchantId          String
  discountId          String?
  billAmountCents     Int
  discountPercent     Int
  discountAmountCents Int
  finalAmountCents    Int
  status              TransactionStatus @default(CONFIRMED)
  createdAt           DateTime          @default(now())

  membership Membership      @relation(fields: [membershipId], references: [id])
  merchant   MerchantProfile @relation(fields: [merchantId], references: [id])
  discount   Discount?       @relation(fields: [discountId], references: [id])

  @@index([membershipId])
  @@index([merchantId])
}

// A merchant's own affiliate/marketer — any regular user, added by the merchant, with a
// commission rate that merchant sets for them specifically. The same user can be an affiliate
// for several merchants at once (section: merchant-level affiliate program, distinct from any
// future platform-wide affiliate system).
model MerchantAffiliate {
  id              String         @id @default(uuid())
  merchantId      String
  userId          String
  commissionType  CommissionType
  commissionValue Int // percent 1-100, or fixed cents, depending on commissionType
  referralCode    String         @unique
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  merchant    MerchantProfile       @relation(fields: [merchantId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]

  @@unique([merchantId, userId])
}

// Created the first time a customer opens a product through an affiliate's referral link.
// Attributes every purchase that customer makes from this merchant (online or in-person QR
// redemption) to that affiliate for 30 days — first click wins, no overriding an active referral.
model AffiliateReferral {
  id                  String   @id @default(uuid())
  merchantAffiliateId String
  merchantId          String // denormalized so checkout/redeem can look this up by (merchantId, customerId) directly
  customerId          String
  productId           String // the product the referral link pointed to (analytics only)
  createdAt           DateTime @default(now())
  expiresAt           DateTime

  merchantAffiliate MerchantAffiliate     @relation(fields: [merchantAffiliateId], references: [id])
  customer          User                  @relation(fields: [customerId], references: [id])
  product           Product               @relation(fields: [productId], references: [id])
  commissions       AffiliateCommission[]

  @@unique([merchantId, customerId])
}

// One row per commission-earning event (an online order or an in-person QR redemption) —
// single source of truth an affiliate and their merchant can both reconcile against.
model AffiliateCommission {
  id                  String              @id @default(uuid())
  merchantAffiliateId String
  referralId          String
  sourceType          AffiliateSourceType
  sourceId            String // Order.id or DiscountTransaction.id
  baseAmountCents     Int
  commissionCents     Int
  createdAt           DateTime            @default(now())

  merchantAffiliate MerchantAffiliate @relation(fields: [merchantAffiliateId], references: [id])
  referral          AffiliateReferral @relation(fields: [referralId], references: [id])

  @@index([merchantAffiliateId])
}

// ---------------------------------------------------------------------------
// Platform settings + wallet (internal "Dalilacom credits") + auto-responder add-on
// ---------------------------------------------------------------------------

// Super-admin-managed key/value settings (pricing, trial length, credit name/rate, payment accounts).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum WalletTxType {
  TOPUP
  SUBSCRIPTION
  ADJUSTMENT
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TopUpVerifier {
  AUTO
  ADMIN
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0) // in Dalilacom credits
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model WalletTransaction {
  id        String       @id @default(uuid())
  userId    String
  type      WalletTxType
  amount    Int // positive = credit, negative = debit
  ref       String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model TopUpRequest {
  id            String         @id @default(uuid())
  userId        String
  method        String // USDT_TRC20 or a local wallet key defined in platform settings
  reference     String // blockchain txid or the wallet's transaction number
  amountClaimed Float? // what the user says they paid (USD for USDT)
  amountCredits Int? // set on approval
  status        TopUpStatus    @default(PENDING)
  verifiedBy    TopUpVerifier?
  note          String?
  createdAt     DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([method, reference])
  @@index([userId])
}

enum ChannelDriver {
  TELEGRAM
  GENERIC_WEBHOOK
  META_PENDING
  FACEBOOK
  INSTAGRAM
}

// A social channel the super admin offers. GENERIC_WEBHOOK lets new platforms be added without code.
model SocialChannel {
  id        String        @id @default(uuid())
  key       String        @unique
  name      String
  driver    ChannelDriver
  isEnabled Boolean       @default(true)
  config    Json          @default("{}")
  createdAt DateTime      @default(now())

  connections ChannelConnection[]
  rules       ResponderRule[]
}

model ChannelConnection {
  id                String   @id @default(uuid())
  userId            String
  channelId         String
  credentialsEnc    String // AES-256-GCM encrypted JSON (bot token, outbound URL/secret, ...)
  externalAccountId String?
  hookToken         String   @unique
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  user         User                   @relation(fields: [userId], references: [id])
  channel      SocialChannel          @relation(fields: [channelId], references: [id])
  interactions ResponderInteraction[]

  @@index([userId])
}

enum ResponderStatus {
  TRIAL
  ACTIVE
  EXPIRED
  OFF
}

model ResponderSubscription {
  id                  String          @id @default(uuid())
  userId              String          @unique
  status              ResponderStatus @default(OFF)
  trialUsed           Boolean         @default(false)
  trialEndsAt         DateTime?
  periodEnd           DateTime?
  aiRepliesUsed       Int             @default(0)
  aiPeriodStart       DateTime?
  businessDescription String?
  tone                String?
  createdAt           DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum ResponderMode {
  FIXED
  AI
}

model ResponderRule {
  id             String        @id @default(uuid())
  userId         String
  name           String
  keywords       String[]
  mode           ResponderMode @default(FIXED)
  replyTemplate  String        @default("")
  aiInstructions String        @default("")
  channelId      String? // null = applies to every connected channel
  postIds        String[]      @default([]) // empty = any message/post; otherwise only comments on these posts (Facebook/Instagram)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  user    User           @relation(fields: [userId], references: [id])
  channel SocialChannel? @relation(fields: [channelId], references: [id])

  @@index([userId])
}

enum InteractionStatus {
  SENT
  NEEDS_REVIEW
  FAILED
  SKIPPED
}

model ResponderInteraction {
  id              String            @id @default(uuid())
  userId          String
  connectionId    String
  conversationRef String // where to send the reply (e.g. Telegram chat id)
  authorName      String
  message         String
  intent          String?
  reply           String?
  status          InteractionStatus
  reason          String?
  postId          String? // the Facebook/Instagram post a comment was made on
  externalId      String? // the platform's own id for this message/comment — makes webhook redelivery idempotent
  createdAt       DateTime          @default(now())

  user       User              @relation(fields: [userId], references: [id])
  connection ChannelConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, externalId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 1B — Geographic Hierarchy, Address, Business/Branch, Product Master/Offer.
//
// Additive foundation: MerchantProfile/Product and everything built on them (Cart, Order, QR,
// Wallet, Affiliate) are untouched and keep working exactly as before. Every existing
// MerchantProfile/Product is backfilled into the new Business/Branch/ProductMaster/MerchantOffer
// tables below via `Business.legacyMerchantProfileId` / `MerchantOffer.legacyProductId` — plain
// (non-FK) string pointers, so the old and new structures can be decoupled cleanly once every
// consumer has migrated in a later phase (section: Compatibility Layer).
// ---------------------------------------------------------------------------

// Country-specific attributes (currency, phone format, timezone, language) live only here —
// never hardcoded in application logic (section: Country).
model Country {
  id              String   @id @default(uuid())
  name            String
  nameArabic      String?
  nameEnglish     String?
  isoCode2        String   @unique // "SY", "DE"
  isoCode3        String?  @unique // "SYR", "DEU"
  currencyCode    String // ISO 4217, e.g. "SYP", "EUR"
  phoneCode       String? // "+963"
  defaultLanguage String   @default("ar")
  timezone        String?
  isActive        Boolean  @default(true)
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  geoUnits  GeoUnit[]
  addresses Address[]

  businesses Business[]
  branches   Branch[]
}

enum GeoLevel {
  REGION
  CITY
  AREA
}

// Self-referential so a country's actual administrative depth is whatever it really has — some
// countries skip REGION and go Country -> City directly, others need >4 levels one day, and
// this model doesn't need a migration either way (section: Geographic Level — "دون إعادة بناء").
model GeoUnit {
  id          String   @id @default(uuid())
  countryId   String
  level       GeoLevel
  parentId    String?
  name        String
  nameArabic  String?
  nameEnglish String?
  code        String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country  Country   @relation(fields: [countryId], references: [id])
  parent   GeoUnit?  @relation("GeoUnitHierarchy", fields: [parentId], references: [id])
  children GeoUnit[] @relation("GeoUnitHierarchy")

  addressesAsRegion  Address[]  @relation("AddressRegion")
  addressesAsCity    Address[]  @relation("AddressCity")
  addressesAsArea    Address[]  @relation("AddressArea")
  businessesAsRegion Business[] @relation("BusinessRegion")
  businessesAsCity   Business[] @relation("BusinessCity")
  businessesAsArea   Business[] @relation("BusinessArea")
  branchesAsRegion   Branch[]   @relation("BranchRegion")
  branchesAsCity     Branch[]   @relation("BranchCity")
  branchesAsArea     Branch[]   @relation("BranchArea")

  @@index([countryId, level])
  @@index([parentId])
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

// General-purpose address foundation (section: Address Entity / Saved Addresses). Optionally
// owned by a User (a saved address); Business/Branch reference their own Address rows too.
model Address {
  id             String        @id @default(uuid())
  userId         String?
  countryId      String
  regionId       String?
  cityId         String?
  areaId         String?
  street         String?
  buildingNumber String?
  postalCode     String?
  additionalInfo String?
  latitude       Float?
  longitude      Float?
  label          AddressLabel?
  labelCustom    String? // free text when label = OTHER
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  country Country  @relation(fields: [countryId], references: [id])
  region  GeoUnit? @relation("AddressRegion", fields: [regionId], references: [id])
  city    GeoUnit? @relation("AddressCity", fields: [cityId], references: [id])
  area    GeoUnit? @relation("AddressArea", fields: [areaId], references: [id])

  businessRegisteredAt Business? @relation("BusinessRegisteredAddress")
  branchAt             Branch?   @relation("BranchAddress")

  @@index([userId])
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

// Independent of User — an account can own/work at several Businesses, and a Business can have
// several members, via BusinessMember (section: Business Entity / Business Ownership). Replaces
// the old MerchantProfile's rigid "one merchant profile per user" shape going forward; the old
// table stays untouched and fully functional during the transition (section: Existing
// MerchantProfile / Compatibility Layer).
model Business {
  id          String         @id @default(uuid())
  name        String
  legalName   String?
  description String?
  categoryId  String?
  phone       String?
  whatsapp    String?
  email       String?
  status      BusinessStatus @default(DRAFT)

  countryId String
  regionId  String?
  cityId    String?
  areaId    String?
  latitude  Float?
  longitude Float?

  registeredAddressId String? @unique

  // Plain reference (not a DB relation) to the MerchantProfile this row was backfilled from, or
  // that was dual-created alongside a new one via POST /merchant/register — never enforced as an
  // FK on purpose (section: Compatibility Layer).
  legacyMerchantProfileId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category          Category? @relation(fields: [categoryId], references: [id])
  country           Country   @relation(fields: [countryId], references: [id])
  region            GeoUnit?  @relation("BusinessRegion", fields: [regionId], references: [id])
  city              GeoUnit?  @relation("BusinessCity", fields: [cityId], references: [id])
  area              GeoUnit?  @relation("BusinessArea", fields: [areaId], references: [id])
  registeredAddress Address?  @relation("BusinessRegisteredAddress", fields: [registeredAddressId], references: [id])

  members  BusinessMember[]
  branches Branch[]
  offers   MerchantOffer[]

  @@index([categoryId])
  @@index([status])
  @@index([countryId])
  @@index([cityId])
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessMemberStatus {
  ACTIVE
  INACTIVE
}

// Foundation only — fine-grained permissions per role/branch come in a later RBAC phase
// (section: Business Ownership). For now this just answers "can this user act for this business".
model BusinessMember {
  id         String               @id @default(uuid())
  businessId String
  userId     String
  role       BusinessMemberRole   @default(OWNER)
  status     BusinessMemberStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

// A Business can have 0..N Branches — including zero (section: Business Without Physical
// Branch — freelancers, online-only stores, at-home services never need one).
model Branch {
  id         String  @id @default(uuid())
  businessId String
  name       String
  code       String?
  phone      String?
  email      String?
  whatsapp   String?

  countryId String
  regionId  String?
  cityId    String?
  areaId    String?
  latitude  Float?
  longitude Float?

  addressId    String?      @unique
  openingHours Json? // foundation only — {mon: [{open, close}], ...} shape, not enforced here
  status       BranchStatus @default(ACTIVE)
  isMain       Boolean      @default(false) // set on the branch created during MerchantProfile backfill

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  country  Country  @relation(fields: [countryId], references: [id])
  region   GeoUnit? @relation("BranchRegion", fields: [regionId], references: [id])
  city     GeoUnit? @relation("BranchCity", fields: [cityId], references: [id])
  area     GeoUnit? @relation("BranchArea", fields: [areaId], references: [id])
  address  Address? @relation("BranchAddress", fields: [addressId], references: [id])

  offers MerchantOffer[]

  @@index([businessId])
  @@index([cityId])
  @@index([areaId])
  @@index([status])
}

enum ProductMasterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// The product itself — brand/model/specs only, never a price, stock level, or condition (those
// are per-offer). Several MerchantOffers from different Businesses can point at the same
// ProductMaster (section: Product Master).
model ProductMaster {
  id             String              @id @default(uuid())
  name           String
  brand          String?
  model          String?
  sku            String?
  barcode        String?
  categoryId     String?
  description    String?
  specifications Json?
  status         ProductMasterStatus @default(ACTIVE)

  // Plain reference to the single Product row this master was backfilled from (never a DB
  // relation — same reasoning as Business.legacyMerchantProfileId).
  legacyProductId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category?       @relation(fields: [categoryId], references: [id])
  offers   MerchantOffer[]

  @@index([categoryId])
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
  OPEN_BOX
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  ARCHIVED
}

// A Business/Branch's own offer of a ProductMaster — every merchant-specific attribute (price,
// stock, condition, title override) lives here, never on ProductMaster (section: Merchant Offer).
model MerchantOffer {
  id              String  @id @default(uuid())
  productMasterId String
  businessId      String
  branchId        String?

  title       String? // overrides ProductMaster.name for this offer's display; falls back to it when unset
  description String?
  sku         String?

  priceCents            Int
  currency              String           @default("SYP")
  memberDiscountEnabled Boolean          @default(false)
  memberPriceCents      Int?
  stock                 Int              @default(0)
  condition             ProductCondition @default(NEW)
  status                OfferStatus      @default(ACTIVE)

  // Plain reference to the Product row this offer was backfilled from.
  legacyProductId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productMaster ProductMaster @relation(fields: [productMasterId], references: [id])
  business      Business      @relation(fields: [businessId], references: [id])
  branch        Branch?       @relation(fields: [branchId], references: [id])

  @@index([productMasterId])
  @@index([businessId])
  @@index([branchId])
  @@index([status])
}

// A place a user saved from the map ("المحفوظات"). Idempotent per (user, merchant).
model FavoriteMerchant {
  id         String   @id @default(uuid())
  userId     String
  merchantId String
  createdAt  DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([userId, createdAt])
}

// Profile photo bytes live in their own table so ordinary user lookups never drag them along.
// Stored in Postgres (not on disk) because the host's filesystem is ephemeral.
model UserAvatar {
  userId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per category per extra language: the translated name and the words people actually type
// (synonyms are searched in every language, so "dentist" finds the Arabic specialty too).
// Category.name holds the default language (Arabic); a default-language row may exist for synonyms only.
model CategoryTranslation {
  id         String   @id @default(uuid())
  categoryId String
  lang       String
  name       String?
  synonyms   String[]

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
}

// Durable AI provider counters, one row per provider, so "did Groq actually answer?" survives a
// deploy or a free-tier sleep. ai.service.ts writes these best-effort: a failed write is swallowed
// and can never break a customer reply, which is why GET /admin/ai-status reports them separately
// from the exact in-memory counters of the running process.
model AiProviderUsage {
  provider   String    @id
  attempts   Int       @default(0)
  successes  Int       @default(0)
  failures   Int       @default(0)
  lastUsedAt DateTime?
  updatedAt  DateTime  @updatedAt
}
