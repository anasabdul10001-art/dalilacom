generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  CONFIRMED
  CANCELLED
}

enum MerchantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  role         Role     @default(CUSTOMER)
  tokenVersion Int      @default(0) // bumped on logout / password reset to invalidate existing JWTs (section 56)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  merchantProfile MerchantProfile?
  cart            Cart?
  orders          Order[]
}

// One pricing plan a customer can subscribe to (Admin-managed, section 24/60/61)
model MembershipPlan {
  id            String   @id @default(uuid())
  name          String
  durationDays  Int
  priceCents    Int
  currency      String   @default("EUR")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
}

// A customer's active/expired subscription instance — this IS the digital card (section 19)
model Membership {
  id            String           @id @default(uuid())
  memberNumber  String           @unique // human-facing membership number
  userId        String
  planId        String
  status        MembershipStatus @default(ACTIVE)
  startDate     DateTime         @default(now())
  endDate       DateTime
  qrSecret      String           // per-membership secret used to derive rotating QR tokens (section 62)
  lastRedeemedTimeStep BigInt?    // replay-protection watermark for QR redemption
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user  User            @relation(fields: [userId], references: [id])
  plan  MembershipPlan  @relation(fields: [planId], references: [id])

  discountTransactions DiscountTransaction[]

  @@index([userId])
}

// Admin-managed, hierarchical (section 10): a category can have a parent category
model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  merchants MerchantProfile[]
  products  Product[]
}

// A merchant's business profile (section 3)
model MerchantProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  businessName    String
  categoryId      String
  address         String?
  latitude        Float?
  longitude       Float?
  phone           String?
  whatsapp        String?
  approvalStatus  MerchantApprovalStatus @default(PENDING) // manual admin approval (section 63)
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])
  discounts Discount[]
  discountTransactions DiscountTransaction[]
  products  Product[]
  orders    Order[]

  @@index([categoryId])
}

// A product in a merchant's e-commerce store (section 5/26)
model Product {
  id                    String   @id @default(uuid())
  merchantId            String
  categoryId            String?
  name                  String
  description           String?
  priceCents            Int
  memberDiscountEnabled Boolean  @default(false)
  memberPriceCents      Int?     // set by the merchant when memberDiscountEnabled (section 5 example: €100 -> €85)
  stock                 Int      @default(0)
  sku                   String?
  isActive              Boolean  @default(true) // merchant-controlled visibility, independent of stock (section 59.1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  merchant   MerchantProfile @relation(fields: [merchantId], references: [id])
  category   Category?       @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([merchantId])
}

// One active cart per customer (section 6)
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

// One order per merchant — a multi-merchant cart splits into one of these per merchant at
// checkout (section 59.5's "Sub-Orders"), each with its own status/tracking.
model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique
  userId              String
  merchantId          String
  status              OrderStatus @default(PENDING)
  subtotalCents       Int
  memberDiscountCents Int         @default(0)
  totalCents          Int
  cancelReason        String?     // required when the merchant cancels (section 59.6)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  merchant MerchantProfile @relation(fields: [merchantId], references: [id])
  items    OrderItem[]

  @@index([userId])
  @@index([merchantId])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String
  productName    String   // snapshot at order time, survives later product edits
  quantity       Int
  unitPriceCents Int      // price actually charged per unit (member price when applied)
  createdAt      DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// A discount rule offered by a merchant (section 4)
model Discount {
  id          String    @id @default(uuid())
  merchantId  String
  title       String
  percent     Int
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  merchant MerchantProfile @relation(fields: [merchantId], references: [id])
  discountTransactions DiscountTransaction[]

  @@index([merchantId])
}

// Single source of truth discount redemption log (section 34)
model DiscountTransaction {
  id              String            @id @default(uuid())
  transactionRef  String            @unique @default(uuid())
  membershipId    String
  merchantId      String
  discountId      String?
  billAmountCents Int
  discountPercent Int
  discountAmountCents Int
  finalAmountCents    Int
  status          TransactionStatus @default(CONFIRMED)
  createdAt       DateTime          @default(now())

  membership Membership      @relation(fields: [membershipId], references: [id])
  merchant   MerchantProfile @relation(fields: [merchantId], references: [id])
  discount   Discount?       @relation(fields: [discountId], references: [id])

  @@index([membershipId])
  @@index([merchantId])
}
