generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  CONFIRMED
  CANCELLED
}

enum MerchantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CommissionType {
  PERCENT
  FIXED
}

enum AffiliateSourceType {
  ORDER
  DISCOUNT_TRANSACTION
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  fullName        String
  role            Role      @default(CUSTOMER)
  tokenVersion    Int       @default(0) // bumped on logout / password reset to invalidate existing JWTs (section 56)
  isEmailVerified Boolean   @default(false)
  isDisabled      Boolean   @default(false) // admin-controlled kill switch, blocks login regardless of tokenVersion
  // Last place the app reported (rounded to ~1 km), so a merchant can announce "within 5 km of my shop".
  // Optional: only set while the person uses the map with location allowed; cleared by DELETE /profile/location.
  lastLatitude      Float?
  lastLongitude     Float?
  locationUpdatedAt DateTime?
  bio             String? // short public description shown on the account's profile / shop page
  language        String? // preferred language (ar, en, ...): what push notifications and emails are written in
  // Country/city used for per-country pricing and tax (sections 64/58). Deliberately a plain ISO-2
  // code rather than a relation: it is set from the account's own claims/address and never needs a
  // join to render a price. `cityId` points at a GeoUnit.
  countryCode     String?
  cityId          String?
  vatNumber       String? // EU business customers: shown on invoices, enables reverse charge later
  avatarUpdatedAt DateTime? // set when a profile photo exists; also the cache-busting version in its URL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     Membership[]
  merchantProfile MerchantProfile?
  avatar          UserAvatar?
  cart            Cart?
  orders          Order[]
  affiliateOf     MerchantAffiliate[] // merchants I market for
  referredAs      AffiliateReferral[] // merchants that credit a specific affiliate for my purchases

  wallet                Wallet?
  walletTransactions    WalletTransaction[]
  topUpRequests         TopUpRequest[]
  responderSubscription ResponderSubscription?
  channelConnections    ChannelConnection[]
  responderRules        ResponderRule[]
  responderInteractions ResponderInteraction[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
  securityEvents          SecurityEvent[]

  addresses         Address[]
  businessMembers   BusinessMember[]
  favoriteMerchants FavoriteMerchant[]

  notifications           Notification[]
  deviceTokens            DeviceToken[]
  broadcasts              Broadcast[]
  socialIdentities        SocialIdentity[]
  loginTickets            LoginTicket[]
  notificationPreferences NotificationPreference[]
  metaOAuthSessions       MetaOAuthSession[]
}

// Only a SHA-256 hash of the raw token is ever stored — the raw value exists only in the
// email link and is never persisted (section: Email Verification).
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Single-use, expiring, hash-only storage — same pattern as EmailVerificationToken
// (section: Password Reset).
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum SecurityEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  TOKEN_REVOKED
  RATE_LIMIT_EXCEEDED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
}

// Append-only audit trail of security-relevant events (section: Security Events). Never
// stores passwords, raw tokens, or secrets — only what's needed to investigate later.
model SecurityEvent {
  id        String            @id @default(uuid())
  userId    String?
  type      SecurityEventType
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// One pricing plan a customer can subscribe to (Admin-managed, section 24/60/61)
// Which sellable service a plan belongs to. The pricing page lists every service from one catalogue
// (sections 24/60), so membership plans, merchant plans and (later) add-ons live in the same table
// instead of three unrelated places.
enum ServiceKind {
  MEMBERSHIP // the customer's digital membership card (section 19/24)
  RESPONDER_CUSTOMER // auto-responder subscription, customer price
  RESPONDER_MERCHANT // auto-responder subscription, merchant price
  MERCHANT_ACCOUNT // a merchant plan (tiers carry their own broadcast quota)
}

// One service plan a customer or merchant can subscribe to. This is the single source of truth for
// prices, duration, trial and what the plan includes (Admin-managed, section 24/60/61).
model ServicePlan {
  id                    String      @id @default(uuid())
  service               ServiceKind @default(MEMBERSHIP)
  name                  String
  description           String?
  durationDays          Int
  trialDays             Int         @default(0) // free trial days before the first charge (0 = none, section 61)
  priceCents            Int
  currency              String      @default("EUR")
  // What subscribing actually costs in wallet credits (the wallet's own unit, section 51). priceCents
  // is the price shown to the customer in `currency`; this is the amount debited. Null on a plan whose
  // priceCents > 0 means the admin has not priced it in credits yet, and subscribing is refused rather
  // than converting currencies with a rate nobody set (sections 24/60/64).
  priceCredits          Int?
  // Merchant plans only: how many follower broadcasts this plan allows per period (section 37/76).
  // Null means "not applicable" for that kind of service.
  monthlyBroadcastLimit Int?
  sortOrder             Int         @default(0) // display order on the pricing page (lower first)
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  memberships Membership[]
  merchants   MerchantProfile[]
  features    PlanFeature[]
  prices      PlanPrice[]

  @@index([service, isActive])
}

// One bullet of a plan's specification list, in the order the pricing page shows it, e.g.
// "✔ 500 AI replies / month" or "✘ follower broadcasts" (included = false).
model PlanFeature {
  id        String  @id @default(uuid())
  planId    String
  text      String
  included  Boolean @default(true)
  sortOrder Int     @default(0)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// A price override for one country (section 64). A plan without a row for the customer's country
// falls back to the plan's own priceCredits, so the admin only enters the exceptions.
model PlanPrice {
  id              String  @id @default(uuid())
  planId          String
  countryId       String
  priceCredits    Int
  cashAmountCents Int?
  currencyCode    String? // defaults to the country's currency when empty
  isActive        Boolean @default(true)

  plan    ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  country Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([planId, countryId])
  @@index([countryId])
}

// The VAT/sales-tax rate applied to a country's invoices (section 58/64). Stored in basis points so
// the arithmetic stays integer: 1900 = 19.00%. A row with no country is the platform default, used
// for customers whose country has no rate of its own.
model TaxRate {
  id            String   @id @default(uuid())
  countryId     String?
  name          String // "VAT 19%" — printed on the invoice exactly as entered
  percentBps    Int // basis points: 1900 = 19.00%
  isDefault     Boolean  @default(false)
  effectiveFrom DateTime @default(now())
  updatedAt     DateTime @updatedAt

  country Country? @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId])
}

// A customer's active/expired subscription instance — this IS the digital card (section 19)
model Membership {
  id                   String           @id @default(uuid())
  memberNumber         String           @unique // human-facing membership number
  userId               String
  planId               String
  status               MembershipStatus @default(ACTIVE)
  startDate            DateTime         @default(now())
  endDate              DateTime
  qrSecret             String // per-membership secret used to derive rotating QR tokens (section 62)
  lastRedeemedTimeStep BigInt? // replay-protection watermark for QR redemption
  // What this membership actually cost when it was bought (a snapshot, so a later price change
  // doesn't rewrite history) and the wallet-ledger row that paid for it (section 58 accounting).
  creditsPaid          Int              @default(0)
  paidTransactionId    String?
  // The first period was a free trial (once per account, from the plan's trialDays); a renewal makes it a paid one.
  isTrial              Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user User        @relation(fields: [userId], references: [id])
  plan ServicePlan @relation(fields: [planId], references: [id])

  discountTransactions DiscountTransaction[]

  @@index([userId])
}

// Admin-managed, hierarchical (section 10): a category can have a parent category
model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  icon      String? // emoji shown on browse tiles
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  translations CategoryTranslation[]
  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryHierarchy")
  merchants    MerchantProfile[]
  products     Product[]

  businesses     Business[]
  productMasters ProductMaster[]
}

// A merchant's business profile (section 3)
model MerchantProfile {
  id              String                 @id @default(uuid())
  userId          String                 @unique
  businessName    String
  categoryId      String
  address         String?
  latitude        Float?
  longitude       Float?
  phone           String?
  whatsapp        String?
  approvalStatus  MerchantApprovalStatus @default(PENDING) // manual admin approval (section 63)
  // The merchant plan the super admin assigned to this shop: its monthlyBroadcastLimit is how many announcements the shop
  // may send per month. No plan = the platform default (settings.broadcasts.merchantDefaultMonthly).
  planId          String?
  rejectionReason String?
  // {"sat":[{"open":"09:00","close":"22:00"}], ...} — validated in routes; evaluated in the platform timezone
  openingHours    Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user                 User                  @relation(fields: [userId], references: [id])
  category             Category              @relation(fields: [categoryId], references: [id])
  plan                 ServicePlan?          @relation(fields: [planId], references: [id])
  favoritedBy          FavoriteMerchant[]
  discounts            Discount[]
  shippingMethods      ShippingMethod[]
  discountTransactions DiscountTransaction[]
  products             Product[]
  adBookings           AdBooking[]
  bannerBookings       BannerBooking[]
  orders               Order[]
  affiliates           MerchantAffiliate[]

  @@index([categoryId])
}

// A product in a merchant's e-commerce store (section 5/26)
model Product {
  id                    String   @id @default(uuid())
  merchantId            String
  categoryId            String?
  name                  String
  description           String?
  priceCents            Int
  memberDiscountEnabled Boolean  @default(false)
  memberPriceCents      Int? // set by the merchant when memberDiscountEnabled (section 5 example: €100 -> €85)
  stock                 Int      @default(0)
  sku                   String?
  isActive              Boolean  @default(true) // merchant-controlled visibility, independent of stock (section 59.1)
  // The online store: a picture (a generated one is drawn from `icon` when there is no photo), the section it is
  // listed under, and the figures a shopper looks at.
  imageUrl              String?
  images                String[] @default([]) // every picture, the first one is imageUrl
  specs                 Json? // [{ label, value }] shown as the product's details
  condition             String? // NEW | USED
  icon                  String?
  storeSection          String?
  rating                Float    @default(0)
  ratingCount           Int      @default(0)
  soldCount             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  merchant           MerchantProfile     @relation(fields: [merchantId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  cartItems          CartItem[]
  orderItems         OrderItem[]
  affiliateReferrals AffiliateReferral[]
  adBookings         AdBooking[]

  @@index([merchantId])
  @@index([storeSection])
}

// One active cart per customer (section 6)
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

// One order per merchant — a multi-merchant cart splits into one of these per merchant at
// checkout (section 59.5's "Sub-Orders"), each with its own status/tracking.
model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique
  userId              String
  merchantId          String
  status              OrderStatus @default(PENDING)
  subtotalCents       Int
  memberDiscountCents Int         @default(0)
  totalCents          Int
  cancelReason        String? // required when the merchant cancels (section 59.6)
  shippingName        String? // the shipping method the customer chose (snapshot)
  shippingCents       Int         @default(0) // its cost, already inside totalCents
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  merchant MerchantProfile @relation(fields: [merchantId], references: [id])
  items    OrderItem[]

  @@index([userId])
  @@index([merchantId])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String
  productName    String // snapshot at order time, survives later product edits
  quantity       Int
  unitPriceCents Int // price actually charged per unit (member price when applied)
  createdAt      DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// A discount rule offered by a merchant (section 4)
model Discount {
  id         String    @id @default(uuid())
  merchantId String
  title      String
  percent    Int
  isActive   Boolean   @default(true)
  startDate  DateTime?
  endDate    DateTime?
  // The shop's own terms: what it covers (ALL | SECTION | PRODUCTS), who may use it and how often, and a note for customers.
  description      String?
  scope            String    @default("ALL")
  scopeSection     String?
  productIds       String[]  @default([])
  maxCustomers     Int? // how many different people may get it (null = no limit)
  perCustomerLimit Int? // how many times each person may get it (null = no limit)
  // The super admin approves every discount before customers can use it.
  status           DiscountApproval @default(PENDING)
  rejectionReason  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  merchant             MerchantProfile       @relation(fields: [merchantId], references: [id])
  discountTransactions DiscountTransaction[]

  @@index([merchantId])
}

// Single source of truth discount redemption log (section 34)
model DiscountTransaction {
  id                  String            @id @default(uuid())
  transactionRef      String            @unique @default(uuid())
  membershipId        String
  merchantId          String
  discountId          String?
  billAmountCents     Int
  discountPercent     Int
  discountAmountCents Int
  finalAmountCents    Int
  status              TransactionStatus @default(CONFIRMED)
  createdAt           DateTime          @default(now())

  membership Membership      @relation(fields: [membershipId], references: [id])
  merchant   MerchantProfile @relation(fields: [merchantId], references: [id])
  discount   Discount?       @relation(fields: [discountId], references: [id])

  @@index([membershipId])
  @@index([merchantId])
}

// A merchant's own affiliate/marketer — any regular user, added by the merchant, with a
// commission rate that merchant sets for them specifically. The same user can be an affiliate
// for several merchants at once (section: merchant-level affiliate program, distinct from any
// future platform-wide affiliate system).
model MerchantAffiliate {
  id              String         @id @default(uuid())
  merchantId      String
  userId          String
  commissionType  CommissionType
  commissionValue Int // percent 1-100, or fixed cents, depending on commissionType
  referralCode    String         @unique
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  merchant    MerchantProfile       @relation(fields: [merchantId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]

  @@unique([merchantId, userId])
}

// Created the first time a customer opens a product through an affiliate's referral link.
// Attributes every purchase that customer makes from this merchant (online or in-person QR
// redemption) to that affiliate for 30 days — first click wins, no overriding an active referral.
model AffiliateReferral {
  id                  String   @id @default(uuid())
  merchantAffiliateId String
  merchantId          String // denormalized so checkout/redeem can look this up by (merchantId, customerId) directly
  customerId          String
  productId           String // the product the referral link pointed to (analytics only)
  createdAt           DateTime @default(now())
  expiresAt           DateTime

  merchantAffiliate MerchantAffiliate     @relation(fields: [merchantAffiliateId], references: [id])
  customer          User                  @relation(fields: [customerId], references: [id])
  product           Product               @relation(fields: [productId], references: [id])
  commissions       AffiliateCommission[]

  @@unique([merchantId, customerId])
}

// One row per commission-earning event (an online order or an in-person QR redemption) —
// single source of truth an affiliate and their merchant can both reconcile against.
model AffiliateCommission {
  id                  String              @id @default(uuid())
  merchantAffiliateId String
  referralId          String
  sourceType          AffiliateSourceType
  sourceId            String // Order.id or DiscountTransaction.id
  baseAmountCents     Int
  commissionCents     Int
  createdAt           DateTime            @default(now())

  merchantAffiliate MerchantAffiliate @relation(fields: [merchantAffiliateId], references: [id])
  referral          AffiliateReferral @relation(fields: [referralId], references: [id])

  @@index([merchantAffiliateId])
}

// ---------------------------------------------------------------------------
// Platform settings + wallet (internal "Dalilacom credits") + auto-responder add-on
// ---------------------------------------------------------------------------

// Super-admin-managed key/value settings (pricing, trial length, credit name/rate, payment accounts).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum WalletTxType {
  TOPUP
  SUBSCRIPTION
  MEMBERSHIP // a customer membership was bought out of the wallet balance
  BROADCAST // a shop paid for an announcement (or got the money back when it was refused)
  AD // a shop paid for advertising space in the store (or got the money back)
  ADJUSTMENT
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TopUpVerifier {
  AUTO
  ADMIN
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0) // in Dalilacom credits
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model WalletTransaction {
  id        String       @id @default(uuid())
  userId    String
  type      WalletTxType
  amount    Int // positive = credit, negative = debit
  ref       String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model TopUpRequest {
  id            String         @id @default(uuid())
  userId        String
  method        String // USDT_TRC20 or a local wallet key defined in platform settings
  reference     String // blockchain txid or the wallet's transaction number
  amountClaimed Float? // what the user says they paid (USD for USDT)
  amountCredits Int? // set on approval
  status        TopUpStatus    @default(PENDING)
  verifiedBy    TopUpVerifier?
  note          String?
  createdAt     DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([method, reference])
  @@index([userId])
}

enum ChannelDriver {
  TELEGRAM
  GENERIC_WEBHOOK
  META_PENDING
  FACEBOOK
  INSTAGRAM
}

// A social channel the super admin offers. GENERIC_WEBHOOK lets new platforms be added without code.
model SocialChannel {
  id        String        @id @default(uuid())
  key       String        @unique
  name      String
  driver    ChannelDriver
  isEnabled Boolean       @default(true)
  config    Json          @default("{}")
  createdAt DateTime      @default(now())

  connections ChannelConnection[]
  rules       ResponderRule[]
}

model ChannelConnection {
  id                String   @id @default(uuid())
  userId            String
  channelId         String
  credentialsEnc    String // AES-256-GCM encrypted JSON (bot token, outbound URL/secret, ...)
  externalAccountId String?
  hookToken         String   @unique
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  user         User                   @relation(fields: [userId], references: [id])
  channel      SocialChannel          @relation(fields: [channelId], references: [id])
  interactions ResponderInteraction[]

  @@index([userId])
}

enum ResponderStatus {
  TRIAL
  ACTIVE
  EXPIRED
  OFF
}

model ResponderSubscription {
  id                  String          @id @default(uuid())
  userId              String          @unique
  status              ResponderStatus @default(OFF)
  trialUsed           Boolean         @default(false)
  trialEndsAt         DateTime?
  periodEnd           DateTime?
  aiRepliesUsed       Int             @default(0)
  aiPeriodStart       DateTime?
  businessDescription String?
  tone                String?
  // What to do with a message no rule matches: nothing (OFF), let the AI answer from the business information, or send a
  // fixed text (TEMPLATE, fallbackReply).
  fallbackMode        String          @default("OFF")
  fallbackReply       String?
  // The end date (trial end or period end) the owner was last warned about, so each ending is announced once.
  expiryNoticeFor     DateTime?
  createdAt           DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum ResponderMode {
  FIXED
  AI
}

model ResponderRule {
  id             String        @id @default(uuid())
  userId         String
  name           String
  keywords       String[]
  mode           ResponderMode @default(FIXED)
  replyTemplate  String        @default("")
  aiInstructions String        @default("")
  channelId      String? // null = applies to every connected channel
  postIds        String[]      @default([]) // empty = any message/post; otherwise only comments on these posts (Facebook/Instagram)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  user    User           @relation(fields: [userId], references: [id])
  channel SocialChannel? @relation(fields: [channelId], references: [id])

  @@index([userId])
}

enum InteractionStatus {
  SENT
  NEEDS_REVIEW
  FAILED
  SKIPPED
}

model ResponderInteraction {
  id              String            @id @default(uuid())
  userId          String
  connectionId    String
  conversationRef String // where to send the reply (e.g. Telegram chat id)
  authorName      String
  message         String
  intent          String?
  reply           String?
  status          InteractionStatus
  reason          String?
  postId          String? // the Facebook/Instagram post a comment was made on
  externalId      String? // the platform's own id for this message/comment — makes webhook redelivery idempotent
  createdAt       DateTime          @default(now())

  user       User              @relation(fields: [userId], references: [id])
  connection ChannelConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, externalId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 1B — Geographic Hierarchy, Address, Business/Branch, Product Master/Offer.
//
// Additive foundation: MerchantProfile/Product and everything built on them (Cart, Order, QR,
// Wallet, Affiliate) are untouched and keep working exactly as before. Every existing
// MerchantProfile/Product is backfilled into the new Business/Branch/ProductMaster/MerchantOffer
// tables below via `Business.legacyMerchantProfileId` / `MerchantOffer.legacyProductId` — plain
// (non-FK) string pointers, so the old and new structures can be decoupled cleanly once every
// consumer has migrated in a later phase (section: Compatibility Layer).
// ---------------------------------------------------------------------------

// Country-specific attributes (currency, phone format, timezone, language) live only here —
// never hardcoded in application logic (section: Country).
model Country {
  id              String   @id @default(uuid())
  name            String
  nameArabic      String?
  nameEnglish     String?
  isoCode2        String   @unique // "SY", "DE"
  isoCode3        String?  @unique // "SYR", "DEU"
  currencyCode    String // ISO 4217, e.g. "SYP", "EUR"
  phoneCode       String? // "+963"
  defaultLanguage String   @default("ar")
  timezone        String?
  isActive        Boolean  @default(true)
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  geoUnits  GeoUnit[]
  addresses Address[]

  businesses Business[]
  branches   Branch[]

  planPrices PlanPrice[]
  taxRates   TaxRate[]
}

enum GeoLevel {
  REGION
  CITY
  AREA
}

// Self-referential so a country's actual administrative depth is whatever it really has — some
// countries skip REGION and go Country -> City directly, others need >4 levels one day, and
// this model doesn't need a migration either way (section: Geographic Level — "دون إعادة بناء").
model GeoUnit {
  id          String   @id @default(uuid())
  countryId   String
  level       GeoLevel
  parentId    String?
  name        String
  nameArabic  String?
  nameEnglish String?
  code        String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country  Country   @relation(fields: [countryId], references: [id])
  parent   GeoUnit?  @relation("GeoUnitHierarchy", fields: [parentId], references: [id])
  children GeoUnit[] @relation("GeoUnitHierarchy")

  addressesAsRegion  Address[]  @relation("AddressRegion")
  addressesAsCity    Address[]  @relation("AddressCity")
  addressesAsArea    Address[]  @relation("AddressArea")
  businessesAsRegion Business[] @relation("BusinessRegion")
  businessesAsCity   Business[] @relation("BusinessCity")
  businessesAsArea   Business[] @relation("BusinessArea")
  branchesAsRegion   Branch[]   @relation("BranchRegion")
  branchesAsCity     Branch[]   @relation("BranchCity")
  branchesAsArea     Branch[]   @relation("BranchArea")

  @@index([countryId, level])
  @@index([parentId])
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

// General-purpose address foundation (section: Address Entity / Saved Addresses). Optionally
// owned by a User (a saved address); Business/Branch reference their own Address rows too.
model Address {
  id             String        @id @default(uuid())
  userId         String?
  countryId      String
  regionId       String?
  cityId         String?
  areaId         String?
  street         String?
  buildingNumber String?
  postalCode     String?
  additionalInfo String?
  latitude       Float?
  longitude      Float?
  label          AddressLabel?
  labelCustom    String? // free text when label = OTHER
  isDefault      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  country Country  @relation(fields: [countryId], references: [id])
  region  GeoUnit? @relation("AddressRegion", fields: [regionId], references: [id])
  city    GeoUnit? @relation("AddressCity", fields: [cityId], references: [id])
  area    GeoUnit? @relation("AddressArea", fields: [areaId], references: [id])

  businessRegisteredAt Business? @relation("BusinessRegisteredAddress")
  branchAt             Branch?   @relation("BranchAddress")

  @@index([userId])
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

// Independent of User — an account can own/work at several Businesses, and a Business can have
// several members, via BusinessMember (section: Business Entity / Business Ownership). Replaces
// the old MerchantProfile's rigid "one merchant profile per user" shape going forward; the old
// table stays untouched and fully functional during the transition (section: Existing
// MerchantProfile / Compatibility Layer).
model Business {
  id          String         @id @default(uuid())
  name        String
  legalName   String?
  description String?
  categoryId  String?
  phone       String?
  whatsapp    String?
  email       String?
  vatNumber   String? // EU business: printed on invoices and used for reverse charge later (section 58)
  status      BusinessStatus @default(DRAFT)

  countryId String
  regionId  String?
  cityId    String?
  areaId    String?
  latitude  Float?
  longitude Float?

  registeredAddressId String? @unique

  // Plain reference (not a DB relation) to the MerchantProfile this row was backfilled from, or
  // that was dual-created alongside a new one via POST /merchant/register — never enforced as an
  // FK on purpose (section: Compatibility Layer).
  legacyMerchantProfileId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category          Category? @relation(fields: [categoryId], references: [id])
  country           Country   @relation(fields: [countryId], references: [id])
  region            GeoUnit?  @relation("BusinessRegion", fields: [regionId], references: [id])
  city              GeoUnit?  @relation("BusinessCity", fields: [cityId], references: [id])
  area              GeoUnit?  @relation("BusinessArea", fields: [areaId], references: [id])
  registeredAddress Address?  @relation("BusinessRegisteredAddress", fields: [registeredAddressId], references: [id])

  members  BusinessMember[]
  branches Branch[]
  offers   MerchantOffer[]

  @@index([categoryId])
  @@index([status])
  @@index([countryId])
  @@index([cityId])
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessMemberStatus {
  ACTIVE
  INACTIVE
}

// Foundation only — fine-grained permissions per role/branch come in a later RBAC phase
// (section: Business Ownership). For now this just answers "can this user act for this business".
model BusinessMember {
  id         String               @id @default(uuid())
  businessId String
  userId     String
  role       BusinessMemberRole   @default(OWNER)
  status     BusinessMemberStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

// A Business can have 0..N Branches — including zero (section: Business Without Physical
// Branch — freelancers, online-only stores, at-home services never need one).
model Branch {
  id         String  @id @default(uuid())
  businessId String
  name       String
  code       String?
  phone      String?
  email      String?
  whatsapp   String?

  countryId String
  regionId  String?
  cityId    String?
  areaId    String?
  latitude  Float?
  longitude Float?

  addressId    String?      @unique
  openingHours Json? // foundation only — {mon: [{open, close}], ...} shape, not enforced here
  status       BranchStatus @default(ACTIVE)
  isMain       Boolean      @default(false) // set on the branch created during MerchantProfile backfill

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  country  Country  @relation(fields: [countryId], references: [id])
  region   GeoUnit? @relation("BranchRegion", fields: [regionId], references: [id])
  city     GeoUnit? @relation("BranchCity", fields: [cityId], references: [id])
  area     GeoUnit? @relation("BranchArea", fields: [areaId], references: [id])
  address  Address? @relation("BranchAddress", fields: [addressId], references: [id])

  offers MerchantOffer[]

  @@index([businessId])
  @@index([cityId])
  @@index([areaId])
  @@index([status])
}

enum ProductMasterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// The product itself — brand/model/specs only, never a price, stock level, or condition (those
// are per-offer). Several MerchantOffers from different Businesses can point at the same
// ProductMaster (section: Product Master).
model ProductMaster {
  id             String              @id @default(uuid())
  name           String
  brand          String?
  model          String?
  sku            String?
  barcode        String?
  categoryId     String?
  description    String?
  specifications Json?
  status         ProductMasterStatus @default(ACTIVE)

  // Plain reference to the single Product row this master was backfilled from (never a DB
  // relation — same reasoning as Business.legacyMerchantProfileId).
  legacyProductId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category?       @relation(fields: [categoryId], references: [id])
  offers   MerchantOffer[]

  @@index([categoryId])
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
  OPEN_BOX
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  ARCHIVED
}

// A Business/Branch's own offer of a ProductMaster — every merchant-specific attribute (price,
// stock, condition, title override) lives here, never on ProductMaster (section: Merchant Offer).
model MerchantOffer {
  id              String  @id @default(uuid())
  productMasterId String
  businessId      String
  branchId        String?

  title       String? // overrides ProductMaster.name for this offer's display; falls back to it when unset
  description String?
  sku         String?

  priceCents            Int
  currency              String           @default("SYP")
  memberDiscountEnabled Boolean          @default(false)
  memberPriceCents      Int?
  stock                 Int              @default(0)
  condition             ProductCondition @default(NEW)
  status                OfferStatus      @default(ACTIVE)

  // Plain reference to the Product row this offer was backfilled from.
  legacyProductId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productMaster ProductMaster @relation(fields: [productMasterId], references: [id])
  business      Business      @relation(fields: [businessId], references: [id])
  branch        Branch?       @relation(fields: [branchId], references: [id])

  @@index([productMasterId])
  @@index([businessId])
  @@index([branchId])
  @@index([status])
}

// A place a user saved from the map ("المحفوظات"). Idempotent per (user, merchant).
model FavoriteMerchant {
  id         String   @id @default(uuid())
  userId     String
  merchantId String
  createdAt  DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([userId, createdAt])
}

// Profile photo bytes live in their own table so ordinary user lookups never drag them along.
// Stored in Postgres (not on disk) because the host's filesystem is ephemeral.
model UserAvatar {
  userId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per category per extra language: the translated name and the words people actually type
// (synonyms are searched in every language, so "dentist" finds the Arabic specialty too).
// Category.name holds the default language (Arabic); a default-language row may exist for synonyms only.
model CategoryTranslation {
  id         String   @id @default(uuid())
  categoryId String
  lang       String
  name       String?
  synonyms   String[]

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
}

// Durable AI provider counters, one row per provider, so "did Groq actually answer?" survives a
// deploy or a free-tier sleep. ai.service.ts writes these best-effort: a failed write is swallowed
// and can never break a customer reply, which is why GET /admin/ai-status reports them separately
// from the exact in-memory counters of the running process.
model AiProviderUsage {
  provider   String    @id
  attempts   Int       @default(0)
  successes  Int       @default(0)
  failures   Int       @default(0)
  lastUsedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

// How each notification type reaches one user (section 87): full (in-app + email), in-app only,
// or off. A missing row means the default, FULL.
enum NotificationMode {
  FULL
  IN_APP_ONLY
  OFF
}

// Section 13 + 87. Types marked WIRED have a real trigger in the code today; the reserved ones are
// declared so a user can already store a preference, and they start firing when their feature lands
// (followers/section 37, chat/section 7, bookings/section 67, price drop/section 83, geo/section 76).
enum NotificationType {
  ORDER_PLACED // WIRED — checkout tells the customer their order is in
  ORDER_STATUS // WIRED — the merchant moves the order, or the customer cancels it
  DISCOUNT_RECEIVED // WIRED — a merchant redeemed the member's QR code (section 34)
  MEMBERSHIP_EXPIRING // WIRED — produced lazily while the membership is close to expiring
  NEW_OFFER // reserved — needs the Follow model (section 37)
  NEW_PRODUCT // reserved — needs the Follow model (section 37)
  CHAT_MESSAGE // reserved — chat is not built yet (section 7)
  BOOKING_REMINDER // reserved — bookings are not built yet (section 67)
  PRICE_DROP // reserved — price tracking is not built yet (section 83)
  GEO_NEARBY // reserved — geo push is not built yet (section 76)
  PERSONALIZED_OFFER // reserved (section 13)
  SYSTEM // admin/system announcements
}

// One row per thing a user has to be told about (section 13). Only notification.service.ts writes
// these, because it is also what applies the preferences above.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json? // payload for the client, e.g. { orderId } or { transactionRef }
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// A phone that can receive push notifications (Firebase Cloud Messaging). One user can have several
// devices; the FCM token is unique, so a token that moves to another account (shared phone, re-login)
// is re-pointed instead of delivering the old owner's notifications to the new one.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Section 87: one row per (user, type) the user has customised. Absence means FULL.
model NotificationPreference {
  id     String           @id @default(uuid())
  userId String
  type   NotificationType
  mode   NotificationMode @default(FULL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// A merchant half-way through "log in with Facebook" (section 7/23). The Facebook callback discovers
// their Pages, and this row carries the encrypted page tokens until they pick which Page (or linked
// Instagram account) to connect. Short-lived and single-use: completing the flow consumes it, and an
// expired one is worthless because the page tokens inside it are only ever read through readSession().
model MetaOAuthSession {
  id         String    @id @default(uuid()) // the handle handed back to the app or browser
  userId     String
  pagesEnc   String // encrypted JSON: [{ id, name, pageAccessToken, instagramAccountId?, instagramUsername? }]
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// An announcement sent to everyone in a place (admin: anywhere; merchant: with their own product/offer attached).
// Kept as history, and it is what the merchant's daily limit is counted from.
model Broadcast {
  id           String   @id @default(uuid())
  senderId     String
  senderRole   Role
  scope        String // COUNTRY | PLACE | RADIUS
  countryId    String?
  geoUnitId    String?
  latitude     Float?
  longitude    Float?
  radiusKm     Float?
  audienceRole Role?
  title        String
  body         String
  productId    String?
  discountId   String?
  targeted     Int // sent: how many were reached; pending: the estimate at submission
  delivered    Int
  // A merchant's announcement is reviewed (by an AI screen, then always by an admin) before anyone receives it.
  status       String   @default("SENT") // PENDING_REVIEW | SENT | REJECTED
  aiVerdict    String? // OK | REVIEW | BLOCK; null when no AI provider was available
  aiReasons    Json?
  reviewNote   String? // why it was rejected
  reviewedById String?
  reviewedAt   DateTime?
  creditsCharged Int     @default(0) // what the shop paid for it (0 = covered by its plan); refunded if refused
  createdAt    DateTime @default(now())

  sender User @relation(fields: [senderId], references: [id])

  @@index([senderId, createdAt])
  @@index([status, createdAt])
}

// "Continue with Google / Facebook": which outside account belongs to which Dalilacom account.
model SocialIdentity {
  id             String   @id @default(uuid())
  userId         String
  provider       String // GOOGLE | FACEBOOK
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

// A one-time pass the server hands the app/web page after a successful social sign-in, so the real session token never
// travels in a URL. Valid for a minute, spent by the first exchange.
model LoginTicket {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// "Change my email": the new address must be confirmed through a link sent to it before the account switches.
model EmailChangeToken {
  id         String    @id @default(uuid())
  userId     String
  newEmail   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AdStatus {
  PENDING // paid, waiting for the admin to approve
  ACTIVE // approved: shown while startsAt <= now < endsAt
  REJECTED
  CANCELLED
}

// A shop renting one of the store's advertising spaces (the picks beside the front-page banner) for some days.
// The space (slot 1..6, per country) is reserved from the moment of booking; the price is paid from the wallet and
// given back if the booking is refused or cancelled.
model AdBooking {
  id              String   @id @default(uuid())
  merchantId      String
  productId       String
  countryCode     String
  days            Int
  credits         Int
  status          AdStatus @default(PENDING)
  requestedStart  DateTime
  startsAt        DateTime
  endsAt          DateTime
  slot            Int
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant MerchantProfile @relation(fields: [merchantId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])

  @@index([countryCode, status])
  @@index([merchantId])
}

// The big rotating banners of the store's front page, managed by the admin (any number, shown in order).
model StoreBanner {
  id             String    @id @default(uuid())
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  title          String
  subtitle       String?
  buttonText     String?
  bg             String    @default("coral") // a colour preset used when there is no picture
  targetType     String    @default("none") // none | product | section | shop | deals | url
  targetValue    String?
  countryCode    String? // null = every country
  startsAt       DateTime?
  endsAt         DateTime?
  imageMime      String?
  imageData      Bytes?
  imageUpdatedAt DateTime?
  views          Int       @default(0)
  clicks         Int       @default(0)
  bookingId      String? // the shop's booking this banner was made for
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// A picture a shop took of its product, kept in the database like profile photos (the host's disk does not last).
model ProductPhoto {
  id         String   @id @default(uuid())
  merchantId String
  mime       String
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([merchantId])
}

// What buyers say about a product: only someone who received an order containing it can write one (one per person; editable).
model ProductReview {
  id        String   @id @default(uuid())
  productId String
  userId    String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

// What buyers say about a shop (after an order from it was delivered).
model MerchantReview {
  id         String   @id @default(uuid())
  merchantId String
  userId     String
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchantId, userId])
  @@index([merchantId, createdAt])
}

// What a shop says about a customer who bought from it (shown to shops only, so they know who they deal with).
model CustomerReview {
  id         String   @id @default(uuid())
  merchantId String
  customerId String
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchantId, customerId])
  @@index([customerId])
}

enum BannerBookingStatus {
  PENDING // paid; waiting for the admin to call the shop
  CONTACTED // the admin spoke to the shop about what the banner should say
  SCHEDULED // the banner was made and is (or will be) on the front page
  REJECTED
  CANCELLED
}

// A shop asking for one of the big rotating banners for some days. It pays from the wallet and leaves its phone/WhatsApp:
// the admin then contacts it to agree what the banner shows, and makes the banner in the panel.
model BannerBooking {
  id              String              @id @default(uuid())
  merchantId      String
  days            Int
  credits         Int
  requestedStart  DateTime
  phone           String
  whatsapp        String?
  note            String?
  status          BannerBookingStatus @default(PENDING)
  bannerId        String?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  merchant MerchantProfile @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
}

enum DiscountApproval {
  PENDING
  APPROVED
  REJECTED
}

/// How a shop sends its orders and what that costs; the customer picks one at checkout.
model ShippingMethod {
  id         String   @id @default(uuid())
  merchantId String
  name       String
  costCents  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  merchant MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}
