DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
QR_TOKEN_TTL_SECONDS=30

# Any long random string (e.g. openssl rand -hex 32). Encrypts social-channel credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=""
# Public https URL of this API (Telegram calls PUBLIC_BASE_URL/hooks/:token).
PUBLIC_BASE_URL="https://your-api.example.com"
# Optional: enables AI replies in the auto-responder. Never put this key in any client app.
ANTHROPIC_API_KEY=""
# Optional: higher TronGrid rate limits for USDT top-up verification.
TRONGRID_API_KEY=""
