DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
QR_TOKEN_TTL_SECONDS=30
NODE_ENV="development"

# Any long random string (e.g. openssl rand -hex 32). Encrypts social-channel credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=""
# Public https URL of this API (Telegram calls PUBLIC_BASE_URL/hooks/:token, and email links point here).
PUBLIC_BASE_URL="https://your-api.example.com"
# Optional: enables AI replies in the auto-responder. Never put this key in any client app.
ANTHROPIC_API_KEY=""
# Optional: Groq is tried first (fast + free). If it fails, the call falls back to Anthropic above.
GROQ_API_KEY=""
# Optional: higher TronGrid rate limits for USDT top-up verification.
TRONGRID_API_KEY=""

# ---- Admin bootstrap (section: Admin Credentials) ----
# Set both once to create the first admin on deploy. Leave unset afterwards — the seed never
# overwrites an existing admin's password; use /auth/forgot-password (or reset-password.html)
# to change it later. Never commit real values here.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# ---- Email (section: Email Verification / Password Reset) ----
# No SMTP configured -> emails are just logged to the server console (safe default, nothing breaks).
# Set SMTP_HOST to actually send mail through any SMTP provider (Resend, SendGrid, SES, etc. all
# expose an SMTP endpoint).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@dalilacom.dev"
EMAIL_VERIFICATION_TOKEN_TTL_HOURS="24"
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"

# ---- CORS (section: CORS) ----
# Comma-separated browser origins allowed to call this API cross-origin. Native apps (Android),
# server-to-server calls, and same-origin pages (public/app, public/admin.html) are unaffected
# either way. Leave empty in production until you actually have a separate frontend domain.
CORS_ALLOWED_ORIGINS=""

# ---- Rate limiting (section: Rate Limiting) ----
# All optional — sensible defaults are baked in (see src/middleware/rateLimit.ts) if left unset.
# AUTH_LOGIN_RATE_LIMIT="10"
# AUTH_SOCIAL_RATE_LIMIT="40"
# AUTH_LOGIN_RATE_WINDOW_MINUTES="15"
# AUTH_REGISTER_RATE_LIMIT="10"
# AUTH_REGISTER_RATE_WINDOW_MINUTES="60"
# AUTH_FORGOT_PASSWORD_RATE_LIMIT="5"
# AUTH_FORGOT_PASSWORD_RATE_WINDOW_MINUTES="15"
# AUTH_RESET_PASSWORD_RATE_LIMIT="10"
# AUTH_RESET_PASSWORD_RATE_WINDOW_MINUTES="15"
# AUTH_VERIFY_EMAIL_RATE_LIMIT="20"
# AUTH_VERIFY_EMAIL_RATE_WINDOW_MINUTES="15"
# AUTH_RESEND_VERIFICATION_RATE_LIMIT="5"
# AUTH_RESEND_VERIFICATION_RATE_WINDOW_MINUTES="15"
# QR_REDEEM_RATE_LIMIT="30"
# QR_REDEEM_RATE_WINDOW_MINUTES="1"
# QR_VERIFY_RATE_LIMIT="60"
# QR_VERIFY_RATE_WINDOW_MINUTES="1"

# ---- Facebook / Instagram auto-responder (Meta app) ----
# App secret (Meta dashboard -> App settings -> Basic) verifies webhook signatures; the verify token is any
# string you also enter when configuring the webhook (callback URL: PUBLIC_BASE_URL/hooks/meta).
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# ---- Facebook Login: connecting a merchant's Page without pasting a token (section 7/23) ----
# App ID from that same Meta app. Until it and the secret are set, /responder/meta/oauth/* answers
# META_NOT_CONFIGURED instead of pretending to connect. These permissions must be approved by Meta
# (App Review + Business Verification) before real merchants can grant them.
META_APP_ID=""
# Must be listed in the Meta app under Facebook Login -> Valid OAuth Redirect URIs.
# Defaults to PUBLIC_BASE_URL/responder/meta/oauth/callback
META_OAUTH_REDIRECT_URI=""
# Optional: override the requested permissions (comma separated). Defaults live in src/services/metaOAuth.service.ts
META_OAUTH_SCOPES=""
# Graph API version used by the OAuth flow and the drivers (default v21.0)
META_GRAPH_VERSION=""
# Deep link the browser bounces back to when the flow ends; the Android app registers this scheme.
APP_DEEP_LINK_SCHEME=""

# ---- Push notifications (Firebase Cloud Messaging) ----
# Firebase console -> Project settings -> Service accounts -> Generate new private key. Paste the whole
# JSON file as ONE value. Server-side secret: never put it in the app or commit it. Unset = no push.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ---- Social sign-in ("Continue with Google / Facebook") ----
# Google: Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application); add the authorized redirect URI
#   <PUBLIC_BASE_URL>/auth/social/google/callback
# Facebook: the Meta app's "Facebook Login" product, valid OAuth redirect URI
#   <PUBLIC_BASE_URL>/auth/social/facebook/callback   (uses META_APP_ID / META_APP_SECRET unless the two below are set)
# A provider with no keys shows no button. Server-side secrets: never put them in an app or commit them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# FACEBOOK_LOGIN_APP_ID=""
# FACEBOOK_LOGIN_APP_SECRET=""
